<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and older. Automatic backup is off (allowBackup="false"); this file excludes everything as a
  second guard. Accounting data, receipts, guest ID numbers and API keys leave the phone only through the
  app's own backup (Settings → Backup), which the owner starts on purpose.
-->
<full-backup-content>
    <exclude domain="root" path="."/>
    <exclude domain="file" path="."/>
    <exclude domain="database" path="."/>
    <exclude domain="sharedpref" path="."/>
    <exclude domain="external" path="."/>
</full-backup-content>
