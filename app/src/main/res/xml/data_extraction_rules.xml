<?xml version="1.0" encoding="utf-8"?>
<!-- API keys (ai_settings.xml) are never backed up or transferred to another device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="ai_settings.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="ai_settings.xml"/>
    </device-transfer>
</data-extraction-rules>
